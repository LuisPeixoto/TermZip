<!doctype html>
<html lang="{{html_lang}}" class="no-js">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{{meta_title}}</title>
  <meta name="description" content="{{meta_description}}">
  <meta name="keywords" content="{{meta_keywords}}">
  <meta name="author" content="Luis Peixoto">
  <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1">
  <meta name="theme-color" content="#f6f4ef">
  <meta name="color-scheme" content="light">
  <link rel="canonical" href="{{canonical}}">
  {% for alt in alternates %}<link rel="alternate" hreflang="{{alt.hreflang}}" href="{{alt.href}}">
  {% endfor %}<link rel="alternate" hreflang="x-default" href="{{default_href}}">

  <meta property="og:type" content="website">
  <meta property="og:site_name" content="TermZip">
  <meta property="og:title" content="{{og_title}}">
  <meta property="og:description" content="{{og_description}}">
  <meta property="og:url" content="{{canonical}}">
  <meta property="og:locale" content="{{og_locale}}">
  {% for alt in alternates %}{% if alt.other %}<meta property="og:locale:alternate" content="{{alt.og_locale}}">
  {% endif %}{% endfor %}<meta property="og:image" content="{{og_image}}">
  <meta property="og:image:width" content="1200">
  <meta property="og:image:height" content="630">
  <meta property="og:image:alt" content="{{og_image_alt}}">
  <meta name="twitter:card" content="summary_large_image">
  <meta name="twitter:title" content="{{og_title}}">
  <meta name="twitter:description" content="{{og_description}}">
  <meta name="twitter:image" content="{{og_image}}">
  <meta name="twitter:image:alt" content="{{og_image_alt}}">

  <link rel="icon" href="{{base}}/favicon.svg" type="image/svg+xml">
  <link rel="icon" href="{{base}}/favicon-32.png" sizes="32x32" type="image/png">
  <link rel="apple-touch-icon" href="{{base}}/apple-touch-icon.png">
  <link rel="manifest" href="{{base}}/site.webmanifest">
  <link rel="preload" href="{{base}}/fonts/bricolage-800.woff2" as="font" type="font/woff2" crossorigin>
  <link rel="preload" href="{{base}}/fonts/hanken-400.woff2" as="font" type="font/woff2" crossorigin>
  <link rel="stylesheet" href="{{base}}/styles.css?v={{asset_version}}">
  <script>document.documentElement.className = "js";</script>
  <script type="application/ld+json">{{{jsonld}}}</script>
</head>
<body data-offers="{{offers_json}}" data-lang="{{lang}}">
  <a class="skip" href="#content">{{skip_link}}</a>

  <header class="site-top">
    <div class="pill-nav">
      <a class="brand" href="{{home_href}}" aria-label="{{home_label}}">
        <img src="{{base}}/favicon.svg" width="30" height="30" alt="" decoding="async">
        <span>TermZip</span>
      </a>
      <nav class="nav" aria-label="{{nav_label}}">
        <a href="#features">{{nav_features}}</a>
        <a href="#privacy">{{nav_privacy}}</a>
        <a href="#install">{{nav_install}}</a>
        <a href="#faq">{{nav_faq}}</a>
      </nav>
      <nav class="langs" aria-label="{{lang_label}}">
        {% for alt in alternates %}<a href="{{alt.href}}" lang="{{alt.html_lang}}" hreflang="{{alt.hreflang}}"{% if alt.current %} aria-current="true"{% endif %}>{{alt.name}}</a>
        {% endfor %}
      </nav>
    </div>
  </header>

  <main id="content">
    <section class="hero" aria-labelledby="hero-title">
      <div class="wrap hero-copy">
        <div class="hero-text">
          <h1 id="hero-title">{{hero_h1}}</h1>
          <p class="hero-sub">{{hero_sub}}</p>
        </div>

        <div class="install" id="install" aria-labelledby="install-title">
          <h2 id="install-title" class="sr">{{install_title}}</h2>
          <div class="tabs" role="tablist" aria-label="{{install_tabs_label}}">
            {% for i in installs %}<button type="button" role="tab" id="tab-{{i.id}}" aria-controls="panel-{{i.id}}" aria-selected="{{i.selected}}" tabindex="{{i.tabindex}}" data-os="{{i.id}}">{{i.label}}</button>
            {% endfor %}
          </div>
          {% for i in installs %}<div class="panel" role="tabpanel" id="panel-{{i.id}}" aria-labelledby="tab-{{i.id}}" data-os="{{i.id}}">
            {% for line in i.lines %}<div class="cmd">
              <code><span class="prompt" aria-hidden="true">$</span>{{line}}</code>
              <button type="button" class="copy" data-copy="{{line}}" data-done="{{install_copied}}">{{install_copy}}</button>
            </div>
            {% endfor %}
            <p class="panel-note">{{i.note}}</p>
          </div>
          {% endfor %}
          <p class="install-meta">{{install_sub}} <a href="https://github.com/LuisPeixoto/TermZip/releases/latest" rel="noopener">{{install_releases}}</a>
            · <a href="https://github.com/LuisPeixoto/TermZip" rel="noopener">{{hero_cta_github}}</a></p>
          <p class="install-warn">{{install_unsigned}}</p>
          <p class="copied" role="status" aria-live="polite"></p>
        </div>
      </div>

      <div class="wrap">
        <div class="stage">
          <span class="shape shape-a" aria-hidden="true"></span>
          <span class="shape shape-b" aria-hidden="true"></span>
          <figure class="stage-shot">
            <img src="{{base}}/img/dracula-1600.jpg" srcset="{{base}}/img/dracula-800.jpg 800w, {{base}}/img/dracula-1600.jpg 1600w" sizes="(min-width: 1240px) 1100px, 92vw" width="1600" height="1058" alt="{{platform_alt}}" decoding="async" fetchpriority="high">
            <figcaption class="sr">{{platform_caption}}</figcaption>
          </figure>
          <div class="chip chip-block" aria-hidden="true">
            <code>{{first.cmd}}</code>{% if first.tag %}<span class="tag">{{first.tag}}</span>{% endif %}<span class="ok">{{first.status}}</span><span class="num">{{first.time}}</span>
          </div>
          <div class="chip chip-key" aria-hidden="true">
            <span class="keys"><kbd>&#8679;</kbd><kbd>&#8984;</kbd><kbd>P</kbd></span><span>{{chip_palette}}</span>
          </div>
        </div>
      </div>
    </section>

    <section class="features" id="features" aria-labelledby="features-title">
      <div class="wrap">
        <header class="sec-head">
          <h2 id="features-title">{{features_title}}</h2>
          <p class="lead">{{features_intro}}</p>
        </header>
        <div class="bento">
          {% for f in features %}<article class="tile tile-{{f.id}}">
            <div class="tile-text">
              <h3>{{f.name}}</h3>
              <p>{{f.text}}</p>
              <a class="more" href="https://github.com/LuisPeixoto/TermZip/blob/main/docs/{{f.link}}" rel="noopener">{{features_docs}}<span class="sr"> · {{f.name}}</span> <span aria-hidden="true">&rarr;</span></a>
            </div>
            {% if f.is_blocks %}<div class="mock mock-blocks" aria-hidden="true">
              {% for d in departures %}<div class="blockcard"><code>{{d.cmd}}</code>{% if d.tag %}<span class="tag">{{d.tag}}</span>{% endif %}<span class="{{d.kind}}">{{d.status}}</span><span class="num">{{d.time}}</span></div>
              {% endfor %}
            </div>{% endif %}
            {% if f.is_tabs %}<div class="mock mock-tabs" aria-hidden="true">
              <div class="win"><div class="win-bar"><span class="on">web</span><span>docs</span><span>+</span></div>
                <div class="win-body"><div class="pane"><i></i><i></i><i class="w60"></i></div><div class="pane"><i></i><i class="w40"></i></div><div class="pane wide"><i class="w70"></i><i></i></div></div></div>
            </div>{% endif %}
            {% if f.is_terminal %}<div class="mock mock-term" aria-hidden="true"><code><b>$</b> vim notes.md</code><code><b>$</b> tmux attach</code><code><b>$</b> ssh dev</code></div>{% endif %}
            {% if f.is_plugins %}<div class="mock mock-perms" aria-hidden="true">
              <div class="perm on"><span>blocks</span><i></i></div><div class="perm"><span>output</span><i></i></div><div class="perm on"><span>type</span><i></i></div><div class="perm"><span>open</span><i></i></div>
              <p>.wasm &middot; 0 imports</p>
            </div>{% endif %}
            {% if f.is_snippets %}<div class="mock mock-tasks" aria-hidden="true"><div><span>build</span><em>Makefile</em></div><div><span>test</span><em>package.json</em></div><div><span>dev</span><em>justfile</em></div></div>{% endif %}
            {% if f.is_ssh %}<div class="mock mock-ssh" aria-hidden="true"><code>ssh -- prod-api</code><span class="conn"><i></i>~/.ssh/config</span></div>{% endif %}
            {% if f.is_themes %}<div class="mock mock-themes" aria-hidden="true">
              <span style="--bg:#282a36;--ac:#bd93f9"></span><span style="--bg:#2e3440;--ac:#88c0d0"></span><span style="--bg:#1e1e2e;--ac:#cba6f7"></span><span style="--bg:#282828;--ac:#fabd2f"></span>
              <span style="--bg:#1a1b26;--ac:#7aa2f7"></span><span style="--bg:#282c34;--ac:#61afef"></span><span style="--bg:#191724;--ac:#ebbcba"></span><span style="--bg:#eff1f5;--ac:#8839ef"></span>
            </div>{% endif %}
            {% if f.is_shape %}<div class="mock mock-keys" aria-hidden="true">
              <div><span class="keys"><kbd>&#8679;</kbd><kbd>&#8984;</kbd><kbd>P</kbd></span><em>{{chip_palette}}</em></div>
              <div><span class="keys"><kbd>&#8984;</kbd><kbd>F</kbd></span><em>Find</em></div>
              <div><span class="keys"><kbd>&#8984;</kbd><kbd>B</kbd></span><em>Blocks</em></div>
              <div><span class="keys"><kbd>&#8984;</kbd><kbd>,</kbd></span><em>Preferences</em></div>
            </div>{% endif %}
            {% if f.is_accessible %}<div class="mock mock-aa" aria-hidden="true"><span class="aa">Aa</span><span class="ratio">AA &middot; 4.5:1</span></div>{% endif %}
          </article>
          {% endfor %}
        </div>
      </div>
    </section>

    <section class="showcase" aria-labelledby="gallery-title">
      <div class="wrap">
        <header class="sec-head">
          <h2 id="gallery-title">{{gallery_title}}</h2>
        </header>
        <div class="show">
          <div class="show-tabs" role="tablist" aria-label="{{gallery_title}}">
            {% for g in gallery %}<button type="button" role="tab" id="stab-{{g.img}}" aria-controls="spanel-{{g.img}}" aria-selected="false" tabindex="-1" data-show="{{g.img}}">{{g.label}}</button>
            {% endfor %}
          </div>
          {% for g in gallery %}<div class="show-panel" role="tabpanel" id="spanel-{{g.img}}" aria-labelledby="stab-{{g.img}}" data-show="{{g.img}}"><figure>
            <img src="{{base}}/img/{{g.img}}-1600.jpg" srcset="{{base}}/img/{{g.img}}-800.jpg 800w, {{base}}/img/{{g.img}}-1600.jpg 1600w" sizes="(min-width: 1240px) 1100px, 92vw" width="1600" height="1058" alt="{{g.alt}}" loading="lazy" decoding="async">
            <figcaption>{{g.caption}}</figcaption>
          </figure></div>
          {% endfor %}
        </div>
      </div>
    </section>

    <section class="privacy" id="privacy" aria-labelledby="privacy-title">
      <div class="wrap two">
        <div>
          <h2 id="privacy-title">{{privacy_title}}</h2>
          <p class="lead">{{privacy_intro}}</p>
          <p><a class="textlink" href="https://github.com/LuisPeixoto/TermZip/blob/main/docs/security-review.md" rel="noopener">{{privacy_link}} <span aria-hidden="true">&rarr;</span></a></p>
        </div>
        <dl class="facts">
          {% for r in privacy_rows %}<div class="fact"><dt>{{r.label}}</dt><dd><span class="check" aria-hidden="true"></span>{{r.value}}</dd></div>
          {% endfor %}
        </dl>
      </div>
    </section>

    <section class="perf" aria-labelledby="perf-title">
      <div class="wrap two">
        <div>
          <h2 id="perf-title">{{perf_title}}</h2>
          <p class="lead">{{perf_intro}}</p>
          <p class="note">{{perf_note}}</p>
          <p><a class="textlink" href="https://github.com/LuisPeixoto/TermZip/blob/main/docs/performance.md" rel="noopener">{{perf_link}} <span aria-hidden="true">&rarr;</span></a></p>
        </div>
        <table class="measures">
          <thead><tr><th scope="col">{{perf_col_measure}}</th><th scope="col">{{perf_col_budget}}</th><th scope="col">{{perf_col_measured}}</th></tr></thead>
          <tbody>
            {% for r in perf_rows %}<tr><th scope="row">{{r.label}}</th><td class="num">{{r.budget}}</td><td class="num lit">{{r.measured}}</td></tr>
            {% endfor %}
          </tbody>
        </table>
      </div>
    </section>

    <section class="faq" id="faq" aria-labelledby="faq-title">
      <div class="wrap narrow">
        <h2 id="faq-title">{{faq_title}}</h2>
        {% for item in faq %}<details>
          <summary>{{item.q}}</summary>
          <p>{{item.a}}</p>
        </details>
        {% endfor %}
      </div>
    </section>

    <section class="cta" aria-labelledby="cta-title">
      <div class="wrap">
        <div class="cta-card">
          <span class="shape shape-a" aria-hidden="true"></span>
          <h2 id="cta-title">{{cta_title}}</h2>
          <p>{{cta_text}}</p>
          <a class="btn" href="#install">{{nav_install}}</a>
        </div>
      </div>
    </section>
  </main>

  <footer class="foot">
    <div class="wrap foot-row">
      <p class="foot-brand"><strong>TermZip</strong> {{version}}<br>{{footer_tagline}}</p>
      <nav aria-label="{{footer_docs}}">
        <a href="https://github.com/LuisPeixoto/TermZip" rel="noopener">GitHub</a>
        <a href="https://github.com/LuisPeixoto/TermZip/tree/main/docs" rel="noopener">{{footer_docs}}</a>
        <a href="https://github.com/LuisPeixoto/TermZip/releases" rel="noopener">{{footer_releases}}</a>
        <a href="https://github.com/LuisPeixoto/TermZip/blob/main/CHANGELOG.md" rel="noopener">{{footer_changelog}}</a>
        <a href="https://github.com/LuisPeixoto/TermZip/blob/main/SECURITY.md" rel="noopener">{{footer_security}}</a>
        <a href="https://github.com/LuisPeixoto/TermZip/blob/main/LICENSE" rel="noopener">{{footer_license}}</a>
      </nav>
    </div>
  </footer>

  <script src="{{base}}/main.js?v={{asset_version}}" defer></script>
</body>
</html>
